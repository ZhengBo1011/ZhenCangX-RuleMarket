{
  "schemaVersion": "2.0",
  "format": "zhencangx.recipe",
  "meta": {
    "id": "com.zhencangx.douyin.service",
    "name": "抖音视频解析（解析服务）",
    "author": "帧藏X 官方规则",
    "version": "1.0.0",
    "description": "抖音视频无水印解析（经解析服务）。规则作者：帧藏X 官方。为什么必须经解析服务：抖音已启用 a_bogus 签名 + Argus 风控，分享页 window._ROUTER_DATA 不再下发视频数据、web 详情接口返回 403（2026-10 端侧实测），纯声明式规则无法生成签名，故把「短链展开 → 取 aweme_id → 调用解析服务 → 提取直链/标题/发布者/发布时间/封面」编排为声明式步骤。需要你提供【解析服务 API Key】：凭据以 X-API-Key 请求头发往 api.douyin.wtf（默认公共实例，第三方服务，请自行评估信任与隐私），规则本体读不到该 Key，只有你在规则中心对该模块显式授权后才会携带，可随时撤回。默认服务地址为公共实例 https://api.douyin.wtf；若要指向自建服务，请改用 douyin-local 规则或按同样结构改写本规则中的服务地址与凭据档案 hosts。注意：抖音域名下的非视频链接（用户主页 / 发现页）也会命中本规则，此时规则会如实上报「不是视频分享链接」而不是报错。"
  },
  "matcher": {
    "hosts": [
      "v.douyin.com",
      "douyin.com",
      "iesdouyin.com"
    ],
    "urlPatterns": [
      "douyin\\.com/video/\\d+",
      "douyin\\.com/(?!(?:discover|user|search|following|recommend)(?:/|$))[A-Za-z0-9_-]{5,}",
      "iesdouyin\\.com/share/(?:video|note)/\\d+"
    ],
    "priority": 30
  },
  "capabilities": [
    "network",
    "json_parse",
    "media_resolve",
    "redirect",
    "auth_reference"
  ],
  "auth": {
    "profile": "douyin-service",
    "label": "抖音解析服务 API Key",
    "header": "X-API-Key",
    "hosts": [
      "api.douyin.wtf"
    ],
    "hint": "在解析服务控制台创建 API Key 后粘贴到上方输入框。该 Key 只会作为 X-API-Key 头发往 api.douyin.wtf，不会发给其它任何站点。"
  },
  "variables": [
    {
      "name": "base",
      "value": "https://api.douyin.wtf"
    },
    {
      "name": "ua",
      "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"
    },
    {
      "name": "referer",
      "value": "https://www.douyin.com/"
    },
    {
      "name": "awemeId",
      "value": ""
    }
  ],
  "steps": [
    {
      "kind": "http.resolve",
      "url": "$input.url",
      "headers": {
        "User-Agent": "$var.ua"
      },
      "timeoutMs": 15000
    },
    {
      "kind": "extract.regex",
      "input": "$step.0",
      "pattern": "/(?:video|note)/(\\d{6,})",
      "group": 1,
      "all": false
    },
    {
      "kind": "variable.set",
      "name": "awemeId",
      "value": "$step.1"
    },
    {
      "kind": "condition.exists",
      "left": "$step.1"
    },
    {
      "kind": "control.branch",
      "condition": "$step.3",
      "then": [
        {
          "kind": "http.request",
          "method": "GET",
          "url": "${var.base}/api/v1/douyin/video?aweme_id=${var.awemeId}&wait=25&include_raw=true",
          "headers": {
            "User-Agent": "$var.ua",
            "Accept": "application/json"
          },
          "timeoutMs": 45000
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.kind"
        },
        {
          "kind": "variable.set",
          "name": "kind",
          "value": "$step.1"
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.media.video.url"
        },
        {
          "kind": "variable.set",
          "name": "mediaUrl",
          "value": "$step.3"
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.title"
        },
        {
          "kind": "variable.set",
          "name": "mediaTitle",
          "value": "$step.5"
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.author.nickname"
        },
        {
          "kind": "variable.set",
          "name": "mediaAuthor",
          "value": "$step.7"
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.raw.create_time"
        },
        {
          "kind": "variable.set",
          "name": "mediaAt",
          "value": "$step.9"
        },
        {
          "kind": "extract.jsonPath",
          "input": "$step.0",
          "path": "$.data.media.covers[0].url"
        },
        {
          "kind": "variable.set",
          "name": "mediaCover",
          "value": "$step.11"
        },
        {
          "kind": "condition.equals",
          "left": "$var.kind",
          "right": "video"
        },
        {
          "kind": "control.branch",
          "condition": "$step.13",
          "then": [
            {
              "kind": "output.media",
              "url": "$var.mediaUrl",
              "mimeType": "video/mp4",
              "extension": "mp4",
              "title": "$var.mediaTitle",
              "headers": {
                "Referer": "$var.referer",
                "User-Agent": "$var.ua"
              }
            },
            {
              "kind": "output.metadata",
              "key": "title",
              "value": "$var.mediaTitle"
            },
            {
              "kind": "output.metadata",
              "key": "author",
              "value": "$var.mediaAuthor"
            },
            {
              "kind": "output.metadata",
              "key": "publishAt",
              "value": "$var.mediaAt"
            },
            {
              "kind": "output.metadata",
              "key": "coverUrl",
              "value": "$var.mediaCover"
            }
          ],
          "else": [
            {
              "kind": "restricted.mark",
              "reason": "非视频内容或解析服务未返回结果",
              "message": "未取得抖音视频信息：该链接可能指向图文/图集内容，或解析服务返回了异步任务、额度不足、服务地址已变更。请在规则中心检查解析服务地址与 API Key 是否有效。"
            }
          ]
        }
      ],
      "else": [
        {
          "kind": "restricted.mark",
          "reason": "不是抖音视频分享链接",
          "message": "该链接未解析出抖音视频 ID：可能指向用户主页、发现页或直播间，而不是单个视频。请使用抖音 App 的「分享 → 复制链接」得到的链接重试。"
        }
      ]
    }
  ]
}
