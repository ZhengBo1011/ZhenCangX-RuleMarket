{
  "manifest": {
    "schemaVersion": "1.0",
    "moduleId": "community.x.nologin",
    "moduleVersion": "1.2.0",
    "name": "X（推特）无登录解析（社区规则）",
    "description": "社区兜底规则：为账号被限制登录、无法在应用内登录 X 的用户提供无登录解析。主通道走 X 公开 GraphQL（guest 访客令牌 + TweetResultByRestId），备通道走 FxTwitter 公开镜像。逐变体提取分辨率 / 码率 / 编码（媒体库展示档位与 H.264 / H.265 / AV1），发布时间双通道输出；仅覆盖公开推文，敏感 / 受保护内容如实上报受限。社区规则，与帧藏X 官方开发无关。启用时需按提示同意「携带凭据头」（Authorization 与 x-guest-token 均为 X 网页客户端公开常量），并建议开启「优先于内置解析」。",
    "author": "帧藏X 社区规则",
    "source": "LOCAL_IMPORT",
    "license": "SEE_LICENSE",
    "homepage": "",
    "supportedPlatforms": [
      "x"
    ],
    "entryRules": [
      "community.x.nologin.video"
    ],
    "capabilities": [
      "network",
      "json_parse",
      "media_resolve"
    ],
    "implementation": "declarative",
    "priority": 30,
    "overridesBuiltin": true
  },
  "rules": [
    "{\"schemaVersion\":\"2.0\",\"format\":\"zhencangx.recipe\",\"meta\":{\"id\":\"community.x.nologin.video\",\"name\":\"X（推特）无登录解析（社区规则）\",\"author\":\"帧藏X 社区规则\",\"version\":\"1.2.0\",\"description\":\"面向登录受限用户的社区兜底规则：全程匿名、不携带任何登录 Cookie。主通道为 X 公开 GraphQL（guest 访客令牌 + TweetResultByRestId），未取得视频时自动改走 FxTwitter 公开镜像（api.fxtwitter.com）。逐变体提取分辨率、码率与编码（媒体库展示 H.264 / H.265 / AV1 与档位排序），发布时间双通道输出（GraphQL 的 created_at 与镜像的秒级时间戳均可）。仅覆盖公开推文的 mp4 直链；敏感、受保护与仅登录可见内容匿名无法获取，会如实上报受限而不是报错。启用本模块需同意「携带凭据头」：向 api.x.com / x.com 发送 Authorization 与 x-guest-token，两者均为 X 网页客户端公开常量，不含任何个人凭据。社区规则，与帧藏X 官方开发无关；X 侧接口字段或 queryId 变更时，更新本规则文件即可修复，无需升级 App。\"},\"matcher\":{\"hosts\":[\"x.com\",\"twitter.com\",\"www.twitter.com\",\"mobile.twitter.com\"],\"urlPatterns\":[\"x\\\\.com/[A-Za-z0-9_]{1,20}/status(?:es)?/\\\\d+\",\"x\\\\.com/i/web/status(?:es)?/\\\\d+\",\"twitter\\\\.com/[A-Za-z0-9_]{1,20}/status(?:es)?/\\\\d+\",\"twitter\\\\.com/i/web/status(?:es)?/\\\\d+\",\"mobile\\\\.twitter\\\\.com/[A-Za-z0-9_]{1,20}/status(?:es)?/\\\\d+\"],\"priority\":30},\"capabilities\":[\"network\",\"json_parse\",\"media_resolve\"],\"variables\":[{\"name\":\"bearer\",\"value\":\"Bearer AAAAAAAAAAAAAAAAAAAAANRILgAAAAAAnNwIzUejRCOuH5E6I8xnZz4puTs%3D1Zv7ttfk8LF81IUq16cHjhLTvJu4FA33AGWWjCpTnA\"},{\"name\":\"queryId\",\"value\":\"2ICDjqPd81tulZcYrtpTuQ\"},{\"name\":\"featuresEnc\",\"value\":\"%7B%22creator_subscriptions_tweet_preview_api_enabled%22%3Atrue%2C%22tweetypie_unmention_optimization_enabled%22%3Atrue%2C%22responsive_web_edit_tweet_api_enabled%22%3Atrue%2C%22graphql_is_translatable_rweb_tweet_is_translatable_enabled%22%3Atrue%2C%22view_counts_everywhere_api_enabled%22%3Atrue%2C%22longform_notetweets_consumption_enabled%22%3Atrue%2C%22responsive_web_twitter_article_tweet_consumption_enabled%22%3Afalse%2C%22tweet_awards_web_tipping_enabled%22%3Afalse%2C%22freedom_of_speech_not_reach_fetch_enabled%22%3Atrue%2C%22standardized_nudges_misinfo%22%3Atrue%2C%22tweet_with_visibility_results_prefer_gql_limited_actions_policy_enabled%22%3Atrue%2C%22longform_notetweets_rich_text_read_enabled%22%3Atrue%2C%22longform_notetweets_inline_media_enabled%22%3Atrue%2C%22responsive_web_graphql_exclude_directive_enabled%22%3Atrue%2C%22verified_phone_label_enabled%22%3Afalse%2C%22responsive_web_media_download_video_enabled%22%3Afalse%2C%22responsive_web_graphql_skip_user_profile_image_extensions_enabled%22%3Afalse%2C%22responsive_web_graphql_timeline_navigation_enabled%22%3Atrue%2C%22responsive_web_enhance_cards_enabled%22%3Afalse%7D\"},{\"name\":\"togglesEnc\",\"value\":\"%7B%22withArticleRichContentState%22%3Afalse%7D\"}],\"steps\":[{\"kind\":\"extract.regex\",\"input\":\"$input.url\",\"pattern\":\"/status(?:es)?/(\\\\d+)\",\"group\":1,\"all\":false},{\"kind\":\"variable.set\",\"name\":\"tweetId\",\"value\":\"$step.0\"},{\"kind\":\"condition.exists\",\"left\":\"$step.0\"},{\"kind\":\"control.branch\",\"condition\":\"$step.2\",\"then\":[{\"kind\":\"http.request\",\"method\":\"POST\",\"url\":\"https://api.x.com/1.1/guest/activate.json\",\"headers\":{\"Authorization\":\"$var.bearer\",\"Accept\":\"application/json\"},\"timeoutMs\":10000},{\"kind\":\"extract.jsonPath\",\"input\":\"$step.0\",\"path\":\"$.guest_token\"},{\"kind\":\"variable.set\",\"name\":\"guestToken\",\"value\":\"$step.1\"},{\"kind\":\"http.request\",\"method\":\"GET\",\"url\":\"https://x.com/i/api/graphql/${var.queryId}/TweetResultByRestId?variables=%7B%22tweetId%22%3A%22${var.tweetId}%22%2C%22withCommunity%22%3Afalse%2C%22includePromotedContent%22%3Afalse%2C%22withVoice%22%3Afalse%7D&features=${var.featuresEnc}&fieldToggles=${var.togglesEnc}\",\"headers\":{\"Authorization\":\"$var.bearer\",\"x-guest-token\":\"$var.guestToken\",\"Accept\":\"application/json\"},\"timeoutMs\":15000},{\"kind\":\"variable.set\",\"name\":\"gqlResp\",\"value\":\"$step.3\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.gqlResp\",\"path\":\"$.data.tweetResult.result.legacy.extended_entities.media[*].video_info.variants[*]\"},{\"kind\":\"variable.set\",\"name\":\"gqlVariants\",\"value\":\"$step.5\"},{\"kind\":\"condition.exists\",\"left\":\"$step.5\"},{\"kind\":\"control.branch\",\"condition\":\"$step.7\",\"then\":[{\"kind\":\"collection.foreach\",\"input\":\"$var.gqlVariants\",\"itemName\":\"u\",\"indexName\":\"n\",\"maxIterations\":16,\"steps\":[{\"kind\":\"extract.jsonPath\",\"input\":\"$item\",\"path\":\"$.url\"},{\"kind\":\"variable.set\",\"name\":\"vUrl\",\"value\":\"$step.0\"},{\"kind\":\"extract.regex\",\"input\":\"$var.vUrl\",\"pattern\":\"(\\\\d{3,4})x(\\\\d{3,4})\",\"group\":1,\"all\":false},{\"kind\":\"variable.set\",\"name\":\"vWidth\",\"value\":\"$step.2\"},{\"kind\":\"extract.regex\",\"input\":\"$var.vUrl\",\"pattern\":\"(\\\\d{3,4})x(\\\\d{3,4})\",\"group\":2,\"all\":false},{\"kind\":\"variable.set\",\"name\":\"vHeight\",\"value\":\"$step.4\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$item\",\"path\":\"$.bitrate\"},{\"kind\":\"variable.set\",\"name\":\"vBitrate\",\"value\":\"$step.6\"},{\"kind\":\"extract.regex\",\"input\":\"$var.vUrl\",\"pattern\":\"/vid/([A-Za-z0-9]+)/\",\"group\":1,\"all\":false},{\"kind\":\"variable.set\",\"name\":\"vCodecToken\",\"value\":\"$step.8\"},{\"kind\":\"condition.exists\",\"left\":\"$var.vCodecToken\"},{\"kind\":\"control.branch\",\"condition\":\"$step.10\",\"then\":[{\"kind\":\"variable.set\",\"name\":\"codec\",\"value\":\"$var.vCodecToken\"}],\"else\":[{\"kind\":\"variable.set\",\"name\":\"codec\",\"value\":\"avc1\"}]},{\"kind\":\"condition.contains\",\"left\":\"$var.vUrl\",\"right\":\".mp4\"},{\"kind\":\"control.branch\",\"condition\":\"$step.12\",\"then\":[{\"kind\":\"output.media\",\"url\":\"$var.vUrl\",\"mimeType\":\"video/mp4\",\"extension\":\"mp4\",\"width\":\"$var.vWidth\",\"height\":\"$var.vHeight\",\"bitrate\":\"$var.vBitrate\",\"codec\":\"$var.codec\"}]}]},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.gqlResp\",\"path\":\"$.data.tweetResult.result.legacy.full_text\"},{\"kind\":\"string.substring\",\"input\":\"$step.1\",\"start\":0,\"length\":120},{\"kind\":\"output.metadata\",\"key\":\"title\",\"value\":\"$step.2\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.gqlResp\",\"path\":\"$.data.tweetResult.result.core.user_results.result.legacy.name\"},{\"kind\":\"output.metadata\",\"key\":\"author\",\"value\":\"$step.4\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.gqlResp\",\"path\":\"$.data.tweetResult.result.legacy.extended_entities.media[0].media_url_https\"},{\"kind\":\"output.metadata\",\"key\":\"coverUrl\",\"value\":\"$step.6\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.gqlResp\",\"path\":\"$.data.tweetResult.result.legacy.created_at\"},{\"kind\":\"output.metadata\",\"key\":\"publishAt\",\"value\":\"$step.8\"}],\"else\":[{\"kind\":\"http.request\",\"method\":\"GET\",\"url\":\"https://api.fxtwitter.com/2/status/${var.tweetId}\",\"headers\":{\"Accept\":\"application/json\"},\"timeoutMs\":10000},{\"kind\":\"variable.set\",\"name\":\"fxResp\",\"value\":\"$step.0\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.fxResp\",\"path\":\"$.status.media.videos[*]\"},{\"kind\":\"variable.set\",\"name\":\"fxVideos\",\"value\":\"$step.2\"},{\"kind\":\"condition.exists\",\"left\":\"$step.2\"},{\"kind\":\"control.branch\",\"condition\":\"$step.4\",\"then\":[{\"kind\":\"collection.foreach\",\"input\":\"$var.fxVideos\",\"itemName\":\"u\",\"indexName\":\"n\",\"maxIterations\":12,\"steps\":[{\"kind\":\"extract.jsonPath\",\"input\":\"$item\",\"path\":\"$.url\"},{\"kind\":\"variable.set\",\"name\":\"vUrl\",\"value\":\"$step.0\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$item\",\"path\":\"$.width\"},{\"kind\":\"variable.set\",\"name\":\"vWidth\",\"value\":\"$step.2\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$item\",\"path\":\"$.height\"},{\"kind\":\"variable.set\",\"name\":\"vHeight\",\"value\":\"$step.4\"},{\"kind\":\"extract.regex\",\"input\":\"$var.vUrl\",\"pattern\":\"/vid/([A-Za-z0-9]+)/\",\"group\":1,\"all\":false},{\"kind\":\"variable.set\",\"name\":\"vCodecToken\",\"value\":\"$step.6\"},{\"kind\":\"condition.exists\",\"left\":\"$var.vCodecToken\"},{\"kind\":\"control.branch\",\"condition\":\"$step.8\",\"then\":[{\"kind\":\"variable.set\",\"name\":\"codec\",\"value\":\"$var.vCodecToken\"}],\"else\":[{\"kind\":\"variable.set\",\"name\":\"codec\",\"value\":\"avc1\"}]},{\"kind\":\"output.media\",\"url\":\"$var.vUrl\",\"mimeType\":\"video/mp4\",\"extension\":\"mp4\",\"width\":\"$var.vWidth\",\"height\":\"$var.vHeight\",\"codec\":\"$var.codec\"}]},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.fxResp\",\"path\":\"$.status.text\"},{\"kind\":\"string.substring\",\"input\":\"$step.1\",\"start\":0,\"length\":120},{\"kind\":\"output.metadata\",\"key\":\"title\",\"value\":\"$step.2\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.fxResp\",\"path\":\"$.status.author.name\"},{\"kind\":\"output.metadata\",\"key\":\"author\",\"value\":\"$step.4\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.fxResp\",\"path\":\"$.status.media.videos[0].thumbnail_url\"},{\"kind\":\"output.metadata\",\"key\":\"coverUrl\",\"value\":\"$step.6\"},{\"kind\":\"extract.jsonPath\",\"input\":\"$var.fxResp\",\"path\":\"$.status.created_timestamp\"},{\"kind\":\"output.metadata\",\"key\":\"publishAt\",\"value\":\"$step.8\"}],\"else\":[{\"kind\":\"restricted.mark\",\"reason\":\"未能获取该推文的视频\",\"message\":\"X 直连接口与社区镜像服务都未返回视频：推文可能已删除、不含视频，或为仅登录可见内容（敏感 / 受保护）。本规则是无登录兜底规则，只覆盖公开推文；需要登录可见内容请在应用内登录后使用内置解析。\"}]}]}],\"else\":[{\"kind\":\"restricted.mark\",\"reason\":\"未识别出推文 ID\",\"message\":\"该链接不是单条推文（仅支持 x.com/<用户>/status/<ID> 形式）。请从 X App 的「分享 → 复制链接」获取单条推文链接后重试。\"}]}]}"
  ]
}